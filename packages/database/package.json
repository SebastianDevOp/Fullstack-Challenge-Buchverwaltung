{
  "name": "@book-manager/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "seed": "tsx seed.ts",
    "migrate:status" : "drizzle-kit check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.5.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.15.4",
    "drizzle-kit": "0.31.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
